{
  "direction": "dark-editorial",
  "mode": "experience",
  "colors": {
    "surface": "#121416",
    "ink": "#eeeae4",
    "accent": "#e4ab8c",
    "muted": "#aaa9a5",
    "line": "#34383b"
  },
  "layout": {
